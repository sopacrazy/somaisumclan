# Token do Clash of Clans Developer API (https://developer.clashofclans.com)
# NUNCA prefixe com VITE_ — isso faria o Vite embutir o token no bundle do navegador.
# Local (vite dev/preview): copie este arquivo para .env e preencha os valores.
# Produção (VPS): não commite os valores reais — ficam em /var/www/somaisumclan/.env
# no servidor, lidos pelos processos server/coc-proxy.cjs e server/strategy-proxy.cjs.
CLASH_API_TOKEN=

# Chave da API da Anthropic (https://console.anthropic.com), usada pelo
# server/strategy-proxy.cjs para gerar as estratégias de ataque com IA.
ANTHROPIC_API_KEY=
